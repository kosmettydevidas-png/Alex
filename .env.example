# Environment Variable Template

# The API Key for OpenAI
OPENAI_API_KEY=

# Set the Flask environment
FLASK_ENV=

# The URL for the database connection
DATABASE_URL=

# The level of logging
LOG_LEVEL=

# The name of the bot
BOT_NAME=

# The version of the bot
BOT_VERSION=

# Host address
HOST=

# Port number
PORT=
